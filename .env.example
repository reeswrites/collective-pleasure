# Copy to .env (which git ignores). Keys live only here or in your shell, never in chat or in git.
# Fill in only what you use. Leave the rest empty.
OPENROUTER_API_KEY=
AIMLAPI_API_KEY=
# OpenRouter model id for the LLM agents (the author picks one), e.g. a cheap open model.
MAR_LLM_MODEL=
# Claude: the anthropic SDK reads ANTHROPIC_API_KEY, or use `ant auth login` and leave it empty.
ANTHROPIC_API_KEY=
